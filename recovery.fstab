# mount point  fstype   device                                        device2      flags
/system        ext4     /dev/block/platform/soc/7824900.sdhci/by-name/system       flags=backup=1
/cache         ext4     /dev/block/platform/soc/7824900.sdhci/by-name/cache        flags=wipeingui;wipeduringfactoryreset
/data          ext4     /dev/block/platform/soc/7824900.sdhci/by-name/userdata     flags=wipeingui
/vendor        ext4     /dev/block/platform/soc/7824900.sdhci/by-name/vendor       flags=backup=1
/persist       ext4     /dev/block/platform/soc/7824900.sdhci/by-name/persist      flags=backup=1;display="Persist"

# raw partition images
/system_image  emmc     /dev/block/platform/soc/7824900.sdhci/by-name/system       flags=backup=1;flashimg=1;display="System Image"
/vendor_image  emmc     /dev/block/platform/soc/7824900.sdhci/by-name/vendor       flags=backup=1;flashimg=1;display="Vendor Image"
/boot          emmc     /dev/block/platform/soc/7824900.sdhci/by-name/boot         flags=backup=1;flashimg=1
/misc          emmc     /dev/block/platform/soc/7824900.sdhci/by-name/misc
/persist       emmc     /dev/block/platform/soc/7824900.sdhci/by-name/persist      flags=backup=1;flashimg=1;display="Persist Image"
/recovery      emmc     /dev/block/platform/soc/7824900.sdhci/by-name/recovery     flags=backup=1;flashimg=1
